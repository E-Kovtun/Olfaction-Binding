# data & model artifacts — ignore content, keep folder structure (.gitkeep)
data/**
!data/**/
!data/**/.gitkeep
!data/**/README.md
# ...except the splits every result stands on, which are versioned (26.09.2026):
# M2OR = LORAX's five folds; Mosquito/Fly = the released `rand` folds and our
# cold-molecule `our_inductive` folds; plus the M2OR index store built from them.
!data/splits_indexes/**
!data/external/ofm/*/rand_splits/**
!data/external/ofm/*/our_inductive_splits/**
!data/processed/full_full_split_indices.npz
# ...and the molecule list M2OR's GIN embedding of record was computed on
!data/processed/molecules/molecule_smiles_all_m2or.csv

# python
__pycache__/
*.pyc
.venv/
.venv-controls/
.venv-embeddings/
.venv-molor/
.venv-esm/
.uv-cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/
.ipynb_checkpoints/

# notebooks are source; only their generated side-products are ignored
notebooks/cache/
notebooks/.ipynb_checkpoints/
notebooks/**/figures/

# results are local experiment artifacts; notebooks are the published experiment record
results/**

*.pt
*.pth
*.ckpt
*.log

# isolated experiments: keep scripts, READMEs and compact CSV manifests/results;
# ignore native binaries and regenerable structures/poses/ligand files
legacy/experiments/**/bin/
legacy/experiments/**/data/**
!legacy/experiments/**/data/
!legacy/experiments/**/data/*.csv

# editor / OS noise
.DS_Store
Thumbs.db

# ensembler smoke-test output
ensemble_test_out/

# server-local queue variants
**/queues/*.local.sh

# the manuscript lives outside the repo's history (user's call, Aug 2026)
paper/
